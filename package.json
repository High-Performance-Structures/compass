{
	"name": "compass",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply compass-db --local",
		"db:migrate:prod": "wrangler d1 migrations apply compass-db --remote",
		"db:migrate-orgs": "bun run scripts/migrate-to-orgs.ts",
		"db:seed-demo": "bun run scripts/seed-demo.ts",
		"prepare": "husky",
		"mobile:build": "bun run scripts/build-mobile-shell.mjs",
		"cap:sync": "cap sync",
		"cap:sync:field": "bun run mobile:build && COMPASS_MOBILE_SHELL=field cap sync",
		"cap:ios": "cap open ios",
		"cap:android": "cap open android",
		"desktop:compile": "tsc -p electron/tsconfig.json",
		"desktop:dev": "bun run desktop:compile && sh -c 'bun dev & next_pid=$!; wait-on http://localhost:3000; ELECTRON_DEV_SERVER_URL=http://localhost:3000 electron dist-electron/electron/main.js; status=$?; kill $next_pid 2>/dev/null; exit $status'",
		"desktop:build": "bun run build && bun run desktop:compile",
		"desktop:pack": "bun run desktop:build && electron-builder --dir",
		"desktop:dist": "bun run desktop:build && electron-builder",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:integration": "vitest run __tests__/integration",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:desktop": "bun run desktop:compile && bun scripts/run-desktop-e2e.mjs",
		"db:init-local": "node scripts/init-local-db.mjs"
	},
